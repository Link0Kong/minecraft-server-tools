[Unit]
Description=DDNS Updater for mc.furina.fun
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/ddns
ExecStart=/usr/bin/python3 /opt/ddns/update_dns.py
StandardOutput=journal
StandardError=journal
# 安全加固
PrivateTmp=yes
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/opt/ddns

[Install]
WantedBy=multi-user.target
